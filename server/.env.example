# ── Required ─────────────────────────────────────────────────────────────────

# REQUIRED in production: set this to a long random secret (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# cPanel Node.js Selector sets this automatically — do NOT override it there.
# For local dev and VPS use: 3001 (or any free port)
PORT=3001

# Set to "production" on live servers.
NODE_ENV=development

# ── Admin account ─────────────────────────────────────────────────────────────

# Set the initial admin password.
# If not set, a random password is generated on first run and printed to the log.
# cPanel tip: set this in the "Environment Variables" section of the Node.js App
# manager so you never have to check the console log for the password.
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# cPanel tip: use an absolute path outside public_html so the DB is not
# publicly downloadable, e.g.:
#   DB_PATH=/home/cpanelusername/pos_data/pos.db
# DB_PATH=/var/data/pos.db

# ── CORS (optional) ───────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS.
# Set this if your web UI is hosted on a different domain/subdomain than the API.
# Example:  CORS_ORIGINS=https://pos.yourstore.com,https://www.yourstore.com
# If not set, all origins are allowed (suitable for Electron desktop client).
# CORS_ORIGINS=https://pos.yourstore.com
