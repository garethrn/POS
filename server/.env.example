JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PORT=3001
NODE_ENV=development

# Optional: Set the initial admin password. If not set, a random password is
# generated on first run and printed to the console.
# ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: Override the SQLite database file path
# DB_PATH=/var/data/pos.db
